# Advanced file-based compatibility. Preferred GUI-first fresh installation:
# sudo scripts/install-controller.sh --gui-setup
# No .env is needed for that mode. Otherwise copy/protect this file and run:
# sudo scripts/install-controller.sh --env-file .env
# The same installer is used at Noida, Pune, AWS and additional management sites.
# Docker Engine + Compose v2 and Python 3.9+ are checked prerequisites.
DATA_ROOT=/var/lib/prthak
NODE_ID=noida-controller-01
SITE=Noida
NODE_IP=auto
CONTROLLER_ORIGIN=
CONTROLLER_BIND_IP=auto
# Initial published dashboard/API port (1..65535, including 443). Internal
# container 8787/backend peer 8786 stay fixed. After installation use the reviewed
# Platform GUI port change; reinstall preserves the GUI-owned installed value.
CONTROLLER_PORT=8787
CONTROLLER_BACKEND_PORT=8786
DATABASE_ROUTER_PORT=5433

# Empty starts an authenticated local setup node. Set the shared cluster password
# in Settings, or provide a private initial seed here (at least 16 characters).
# Joining still verifies the existing node's HTTPS certificate/CA fingerprint.
EXISTING_NODE_IP=
CLUSTER_PASSWORD=

# Optional initial local Super Admin token (32+ random characters). Empty generates
# one privately and prints its FILE location, never the secret itself.
SUPER_ADMIN_TOKEN=

# Optional initial Microsoft Entra SSO. Keep ALL blank for local setup-token
# access; fill tenant/client/callback together before a production pilot.
# Callback must be https://YOUR_STABLE_ORIGIN/api/v1/auth/callback.
# Use the Entra OBJECT ID for the first Super Admin. Invite a second independent
# Entra Super Admin in Users & Access before enabling production enforcement.
SEG_ENTRA_TENANT_ID=
SEG_ENTRA_CLIENT_ID=
SEG_ENTRA_REDIRECT_URI=
SEG_BOOTSTRAP_SUPER_ADMIN_OID=
# Absolute owned mode 0600 UTF-8 file, copied privately into the controller.
# Its original host path and content never become Docker environment values.
SEG_ENTRA_CLIENT_SECRET_FILE=
# Alternative: SEG_ENTRA_CLIENT_SECRET=<private value> in this mode 0600 .env.
# Reinstall preserves configured auth and refuses silent secret rotation.

# Optional HTTP runtime overrides. Blank workers selects AUTO: 1 for standalone
# SQLite, 2 after HA PostgreSQL activation. Default threads: 32.
# Workers 1..16; threads 2..128. Initial settings are preserved on reinstall.
SEG_HTTP_WORKERS=
SEG_HTTP_THREADS=

# PostgreSQL connections are reused only inside running worker processes.
# Every borrow starts a fresh checked transaction; there is no authority cache.
# Defaults per worker: metadata 16, traffic 4, wait at most 5 seconds.
# Budget DB connections across ALL management nodes and worker processes.
# Valid bounds: metadata 1..64, traffic 1..16, wait 1..15 seconds.
SEG_DB_POOL_META_MAX=
SEG_DB_POOL_TRAFFIC_MAX=
SEG_DB_POOL_WAIT_SECONDS=

# Management members do not automatically become database/quorum voters.
# Exactly three approved voters receive three PostgreSQL copies plus etcd.
# Database start requires a real, operator-approved watchdog; no softdog bypass.
WATCHDOG_APPROVED=false
WATCHDOG_DEVICE=/dev/watchdog0
