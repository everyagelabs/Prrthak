# TEMPLATE ONLY. Replace every REPLACE_* value; do not commit a populated copy.
# Install as /etc/prthak/controller.env with owner root:root and mode 0600.
# Each node has a unique ID/site. Shared DSNs and Entra configuration must match.
SEG_CONTROLLER_ID=dc1-controller-a
SEG_CONTROLLER_SITE=dc1

# External HA writer endpoints: exactly one writable primary per database.
# Percent-encode password characters if using URI credentials.
SEG_DATABASE_URL="postgresql://prthak_meta:REPLACE_METADATA_PASSWORD@metadata-primary.example.internal:5432/prthak_metadata?sslmode=verify-full&sslrootcert=/etc/prthak/pki/postgres-ca.pem&target_session_attrs=read-write&connect_timeout=3"
SEG_TRAFFIC_DATABASE_URL="postgresql://prthak_traffic:REPLACE_TRAFFIC_PASSWORD@traffic-primary.example.internal:5432/prthak_traffic?sslmode=verify-full&sslrootcert=/etc/prthak/pki/postgres-ca.pem&target_session_attrs=read-write&connect_timeout=3"

# Single-tenant confidential Web client; stable origin on every controller.
# Entra mode ignores legacy tokens. Application DB is the role authority.
SEG_ENTRA_TENANT_ID=REPLACE_TENANT_UUID
SEG_ENTRA_CLIENT_ID=REPLACE_APPLICATION_CLIENT_UUID
SEG_ENTRA_REDIRECT_URI=https://prthak.example.internal/api/v1/auth/callback
# Private regular file (0600 or stricter), readable by the prthak service account.
# Contains only the secret value; do not also set SEG_ENTRA_CLIENT_SECRET.
SEG_ENTRA_CLIENT_SECRET_FILE=/etc/prthak/secrets/entra-client-secret

# Initial setup ONLY: existing user's Entra Object ID, not email/client/app ID.
# Works only with an empty app-user table. Remove after first successful sign-in.
SEG_BOOTSTRAP_SUPER_ADMIN_OID=REPLACE_INITIAL_USER_OBJECT_UUID

# Needed on each controller serving managed-enforcement health requests.
# Source must be local and in agent management_sources; targets must be scoped.
# SEG_MANAGEMENT_PROBE_SOURCE_IP=10.90.0.5
# SEG_MANAGEMENT_PROBE_TARGET_CIDRS=10.40.0.0/16,10.50.0.0/16
