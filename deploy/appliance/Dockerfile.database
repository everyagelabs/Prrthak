# Existing glibc PGDATA is refused by the manager before this musl runtime starts.
FROM postgres:16.15-alpine3.24@sha256:0cefaabd882e42bcb2a2f3dc56d3ce4770560ba62fd7f197f1a2e008fd5731ab
RUN rm -f /usr/local/bin/gosu \
    && apk upgrade --no-cache \
    && apk add --no-cache python3 py3-pip ca-certificates \
    && python3 -m venv /opt/patroni \
    && test "$(id -u postgres):$(id -g postgres)" = '70:70' \
    && sed -i 's/^postgres:x:70:70:/postgres:x:999:999:/' /etc/passwd \
    && sed -i 's/^ping:x:999:/ping:x:998:/;s/^postgres:x:70:/postgres:x:999:/' /etc/group \
    && test "$(id -u postgres):$(id -g postgres)" = '999:999' \
    && chown -R 999:999 /var/lib/postgresql /var/run/postgresql \
    && mkdir -p /usr/lib/postgresql/16 \
    && ln -s /usr/local/bin /usr/lib/postgresql/16/bin
RUN /opt/patroni/bin/pip install --no-cache-dir --upgrade 'pip==26.2.2' 'setuptools==84.1.0' \
    && /opt/patroni/bin/pip install --no-cache-dir 'patroni[etcd3,psycopg3]>=4.1,<5'
COPY bootstrap_roles.py /opt/prthak/bootstrap_roles.py
COPY rotation_helper.py /opt/prthak/rotation_helper.py
COPY restore_helper.py /opt/prthak/restore_helper.py
RUN /opt/patroni/bin/python -m pip uninstall -y pip setuptools wheel \
    && apk del --no-cache py3-pip \
    && /opt/patroni/bin/python -c 'import importlib.util, patroni.dcs.etcd3, psycopg; assert all(importlib.util.find_spec(name) is None for name in ("pip", "setuptools", "wheel"))' \
    && /opt/patroni/bin/patroni --version
RUN chmod 0700 /var/lib/postgresql/data
USER postgres
STOPSIGNAL SIGTERM
ENTRYPOINT ["/opt/patroni/bin/patroni", "/config/patroni.json"]
